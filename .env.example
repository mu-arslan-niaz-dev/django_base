# Copy to `.env` and set values. Never commit `.env`.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — leave DB_NAME empty for SQLite. Set DB_NAME (and credentials) for PostgreSQL.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# DB_CONN_MAX_AGE=600
# DB_SSLMODE=prefer
